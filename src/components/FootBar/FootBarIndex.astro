---
import FootBarLink from '@/components/FootBar/FootBarLink.astro';
import { vLinks} from '@/js/index.js';
---

<div class="cFootBar">
  
  <div class="cIconsFootBar">
    <FootBarLink 
      vHref={vLinks.GitHub} 
      vTitle="GitHub" 
      vIcoBtn="icnsLinks.svg#icoGitHub"
    />
    <FootBarLink 
      vHref={vLinks.LinkedIn} 
      vTitle="LinkedIn" 
      vIcoBtn="icnsLinks.svg#icoLinkedIn"
    />
    <FootBarLink 
      vHref={vLinks.CV} 
      vTitle="CV" 
      vIcoBtn="icnsLinks.svg#icoCV"
    />

  </div>

  <p>Sitio web desarrollado con
    <img src="/astro.svg" alt="Astro logo">
  </p>

</div>

<style>

  .cFootBar {
    background-color: rgb(var(--vBarBackColor));
    width: 100%;
    min-height: var(--vBarHeight);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: .5rem 0;
    color: var(--vFontColor);
    font-family: var(--vRubikRegular);
    font-size: 18px;

    & .cIconsFootBar {
      width: 9rem;
      display: flex;
      justify-content: space-between;
      & a {
        color: var(--vRubikRegular);
        
        & svg {
          --vSize: 2.5rem;
          width: var(--vSize);
          height: var(--vSize);
          stroke-width: 2.5;
        }
      }
    }

    & p {
      display: flex;
      align-items: center;

      & img {
        width: 2rem;
        height: 2rem;
        margin-left: 5px;
      }
    }

  }

</style>