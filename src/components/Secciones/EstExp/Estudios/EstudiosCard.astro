---
import "@/components/Secciones/EstExp/indexEstExp.css";
import JSONEstudios from "@/js/JSONEstudios.json";
import PuntoBarra from '@/components/PuntoBarra.astro';
---

{JSONEstudios.map((item) => {
  return (
    <div class="cEstudioCard">
      <PuntoBarra />
      <div class="cEstudio">
        <p>{item.jsonUniversity}
          {item.jsonCity != null ? <> - {item.jsonCity}</> : null}
          &nbsp; &nbsp; {item.jsonTime}
        </p>
        <p>{item.jsonCourse}</p>
        
      </div>
    </div>
  );
})}
