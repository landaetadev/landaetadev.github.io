---
import { vLinks } from '@/js/index.js';
import { BtnLinkLarge } from '@/pages/index.astro';
---
<div class="cCoverLinks">
  <BtnLinkLarge vIcoBtn="icnsLinks.svg#icoGitHub" 
                vText="GitHub" 
                vHref={vLinks.GitHub} 
                vTarget="_blank"/>

  <BtnLinkLarge vIcoBtn="icnsLinks.svg#icoLinkedIn" 
                vText="LinkedIn" 
                vHref={vLinks.LinkedIn} 
                vTarget="_blank"/>

  <BtnLinkLarge vIcoBtn="icnsLinks.svg#icoCV" 
                vText="CV" 
                vHref={vLinks.CV}
                vTarget="_blank"/>
</div>

<style>

  .cCoverLinks {
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 0 1rem;

    @media ( width <= 1000px ) {
        flex-direction: column;
        align-items: center;
        gap: 1rem 0;
    }
  }

</style>